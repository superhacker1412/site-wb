NODE_ENV=development
PORT=4000

# Use a dedicated DB user in production. Do NOT commit real passwords.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/site_wb?schema=public"

CLIENT_ORIGIN="http://localhost:8080"
TRUST_PROXY=1

# JWT secrets must be long random strings in production.
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=400
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
FEEDBACK_RATE_LIMIT_WINDOW_MS=3600000
FEEDBACK_RATE_LIMIT_MAX=25
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change_me"
