    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "prisma": "^6.4.1",
    "sanitize-html": "^2.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
